{
  "_comment": "全局构建配置：控制打包产物名称、入口以及各阶段（Stage/Obfuscate/Cython/Nuitka）的行为",
  "_project_root_note": "需要打包的项目根目录，可写绝对路径或相对于 build_config.json 的相对路径",
  "project_root": "../ft_futures_data",
  "_project_name_note": "生成的可执行产物名称，影响 dist 目录下的文件名",
  "project_name": "ft_futures_risk_ctrl",
  "_entry_note": "项目入口脚本，决定从哪个模块启动（默认为仓根 main.py）",
  "entry": "main.py",
  "_output_dir_note": "最终产物输出目录，Stage 和 Nuitka 结果都会放置在此目录下",
  "output_dir": "dist",
  "copy": {
    "_comment": "Stage 阶段相关设置：控制复制到临时目录时需要剔除的文件/目录，避免多余模块参与后续处理",
    "exclude": [
      ".git",
      "__pycache__",
      "dist",
      "build",
      "logs",
      "risk_original_backup",
      "nohup.out",
      "*.egg-info",
      "*.pyc"
    ]
  },
  "obfuscate": {
    "_comment": "python-minifier 混淆设置：影响 collect/ 与 risk/ 模块源码的变量名/函数名重命名策略",
    "enabled": true,
    "_enabled_note": "是否开启混淆阶段；关闭后保留原始源码跳过保护",
    "rename_globals": false,
    "_rename_globals_note": "是否重命名全局名称（函数/类）。若模块对外暴露 API，请保持 false 防止 AttributeError",
    "rename_locals": true,
    "_rename_locals_note": "是否重命名局部变量，进一步保护内部算法实现",
    "remove_literals": true,
    "_remove_literals_note": "是否移除独立字符串/常量字面量，用于隐藏日志文本或提示信息",
    "remove_annotations": true,
    "_remove_annotations_note": "是否移除类型注解，避免泄露结构信息",
    "include_dunder": false,
    "_include_dunder_note": "是否混淆 __init__.py 等双下划线文件，默认为 false 以保持包结构稳定",
    "exclude": [
      "build_tools",
      "tests"
    ],
    "_exclude_note": "混淆时排除的模块目录，避免处理构建工具或测试用例",
    "skip_files": [],
    "_skip_files_note": "需要跳过混淆的具体文件路径列表，可用于保护易出错的模块"
  },
  "cython": {
    "_comment": "Cython 编译设置：指定 risk/、collect/ 等模块是否被转换为 C 扩展以隐藏源码并提升执行效率",
    "enabled": true,
    "_enabled_note": "是否启用 Cython 编译阶段；关闭后将只进行混淆+打包",
    "targets": [
      "."
    ],
    "_targets_note": "需要转换为 C 扩展的目录或文件列表。使用 [\".\"] 表示编译 project_root 下所有 .py 文件",
    "exclude": [
      "build_tools",
      "tests",
      "wheels",
      "logutils.py"
    ],
    "_exclude_note": "Cython 编译时需要排除的目录/文件，避免构建工具、测试、特殊语法模块被编译（如 logutils.py 中的 starred expression）",
    "language_level": "3",
    "_language_level_note": "Cython 语言级别设置，对应 Python 3 语法",
    "nthreads": 0,
    "_nthreads_note": "Cython 编译线程数，0 表示让 Cython 自动选择",
    "remove_python": false,
    "_remove_python_note": "若设为 true，会在编译成功后删除对应的 .py 文件，仅保留 .so/.pyd"
  },
  "nuitka": {
    "_comment": "Nuitka 打包设置：控制最终可执行文件输出形式，并指明需要包含的依赖、资源与缓存目录",
    "enabled": true,
    "_enabled_note": "是否执行 Nuitka 打包阶段；关闭后仅执行混淆 + Cython",
    "standalone": true,
    "_standalone_note": "启用独立模式，确保产物包含运行所需的 Python 运行时和依赖",
    "onefile": true,
    "_onefile_note": "输出单文件可执行程序；如需更快启动，可改为 false 生成目录结构",
    "remove_output": true,
    "_remove_output_note": "在打包前清理旧的输出目录，避免产物冲突",
    "assume_yes_for_downloads": true,
    "_assume_yes_for_downloads_note": "自动确认 Nuitka 可能触发的依赖下载提示（无网环境可保持 true）",
    "include_package": [
      "pandas",
      "numpy",
      "sqlalchemy"
    ],
    "_include_package_note": "需要强制打包的第三方包，用于数据处理与 ORM 模块",
    "include_module": [],
    "_include_module_note": "需要显式包含的单个模块列表（用于反射/动态导入的场景）",
    "include_data_dir": [],
    "_include_data_dir_note": "以目录形式附加的数据资源映射，例如 \"config=config\"",
    "include_data_files": [],
    "_include_data_files_note": "以文件形式附加的资源映射，例如 \"config.ini=config/config.ini\"",
    "plugin_enable": [],
    "_plugin_enable_note": "需要启用的 Nuitka 插件，例如 numpy、multiprocessing 等",
    "nofollow_imports": [],
    "_nofollow_imports_note": "不需要解析的模块路径，避免将大型依赖一起打包",
    "extra_args": [],
    "_extra_args_note": "传递给 Nuitka 的额外命令行参数（如 --lto=yes 等优化选项）",
    "cache_dir": ".nuitka_cache",
    "_cache_dir_note": "Nuitka 缓存目录，默认放在项目根目录下，避免写入到 /root/.cache 造成权限问题"
  }
}
